{
  "name": "my-signet",
  "private": true,
  "version": "0.14.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "check:signet-conformance": "node tools/check-signet-conformance.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:webkit": "npx playwright test --project=mobile-webkit-qr",
    "test:e2e:cross-app": "npx playwright test --config playwright.cross-app.config.ts",
    "test:e2e:cross-app:live": "PLAYWRIGHT_SKIP_WEBSERVER=1 SIGNET_BASE_URL=https://mysignet.app CANARY_BASE_URL=https://canary.trotters.cc npx playwright test --config playwright.cross-app.config.ts",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@forgesworn/kenspeckle": "^0.2.0",
    "@forgesworn/shamir-words": "^1.2.0-alpha.1",
    "@forgesworn/signet-contacts": "git+https://github.com/forgesworn/signet-contacts.git#fd321b3d53f009f5bec27de54bf34722683e7391",
    "@forgesworn/tessera-kit": "^0.2.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.2.0",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.0",
    "jsqr": "^1.4.0",
    "nostr-tools": "^2.24.1",
    "nsec-tree": "^1.6.0-alpha.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "signet-protocol": "^1.11.0",
    "spoken-token": "^2.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.4",
    "signet-verify": "^0.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-build": "^7.4.0",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "serialize-javascript": "^7.0.5",
    "tar": "^7.5.22",
    "@capacitor/assets": {
      "sharp": "$sharp"
    },
    "replace": {
      "minimatch": "^3.1.4"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
